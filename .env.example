# Copy to .env and fill in. NEVER commit .env.

# --- Gnani speech (required for voice) --------------------------------------------
GNANI_API_KEY=

# --- LLM: pick ONE ----------------------------------------------------------------
# Option A: Gemini (free tier) through its OpenAI-compatible endpoint
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_MODEL=gemini-3.8-flash

# Option B: Anthropic
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
# LLM_MODEL=claude-sonnet-5-5

# --- Speed knobs (all optional) ---------------------------------------------------
# LLM_CACHE=0                  # 0 = never reuse earlier LLM answers (default 1)
# TTS_CACHE=0                  # 0 = never reuse earlier voice audio (default 1)
# PREWARM=0                    # 0 = don't pre-generate the scripted voice lines at start (default 1)
# STT_GRACE_S=1.0              # after the first STT language answers, wait at most this long for the other
# LLM_ANALYZER_MODEL=          # a faster/cheaper model just for the "understanding" call
# LLM_REASONING_EFFORT=        # Gemini thinking level: minimal | low | off
